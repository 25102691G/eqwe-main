page {
  --bg-page: #f6f8f5;
  --surface: #ffffff;
  --surface-soft: #eff5f2;
  --ink: #12231f;
  --muted: #66756f;
  --line: #dce5e0;
  --green: #0d7a63;
  --green-soft: #ddeee8;
  --blue: #235c7d;
  --blue-soft: #e1ecf2;
  --coral: #d96d57;
  --coral-soft: #f6e5df;
  --amber: #b78318;
  --amber-soft: #f2e8ce;
  min-height: 100%;
  background: var(--bg-page);
  color: var(--ink);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: 0;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 36rpx 144rpx;
}

.page--sub {
  padding-bottom: 48rpx;
}

.top-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin: 28rpx 0 28rpx;
}

.h1 {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.14;
  color: var(--ink);
}

.h2 {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  color: var(--ink);
}

.h3 {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--ink);
}

.caption {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.card--soft {
  background: var(--surface-soft);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.pill--green {
  background: var(--green-soft);
  color: var(--green);
}

.pill--blue {
  background: var(--blue-soft);
  color: var(--blue);
}

.pill--coral {
  background: var(--coral-soft);
  color: var(--coral);
}

.pill--amber {
  background: var(--amber-soft);
  color: var(--amber);
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.button--primary {
  background: var(--green);
  color: #ffffff;
}

.button--ghost {
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink);
}

.button--soft {
  background: var(--green-soft);
  color: var(--green);
}

.input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 168rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.55;
}

.notice {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 24rpx;
  line-height: 1.55;
}

.error {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--coral-soft);
  color: var(--coral);
  font-size: 24rpx;
  line-height: 1.55;
}

.preview-image,
.result-image {
  width: 100%;
  border-radius: 16rpx;
  background: var(--surface-soft);
}

.preview-image {
  height: 520rpx;
}

.mini-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
}

.mini-icon--green {
  background: var(--green-soft);
}

.mini-icon--blue {
  background: var(--blue-soft);
}

.mini-icon--coral {
  background: var(--coral-soft);
}

.mini-icon--amber {
  background: var(--amber-soft);
}
