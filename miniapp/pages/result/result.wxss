.empty-result .button {
  margin-top: 24rpx;
}

.context-status {
  margin-top: 24rpx;
}

.summary-card {
  margin-top: 24rpx;
}

.score-box {
  min-width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: var(--green);
  color: #ffffff;
  text-align: center;
}

.score-value {
  font-size: 46rpx;
  font-weight: 900;
  line-height: 128rpx;
}

.summary-text {
  margin-top: 24rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.7;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metric-card {
  min-height: 180rpx;
}

.metric-score {
  margin: 14rpx 0 10rpx;
  color: var(--green);
  font-size: 36rpx;
  font-weight: 900;
}

.metric-card--blue .metric-score {
  color: var(--blue);
}

.metric-card--amber .metric-score {
  color: var(--amber);
}

.metric-card--coral .metric-score {
  color: var(--coral);
}

.constitution-row {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.tab-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.tab {
  min-height: 64rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  color: var(--muted);
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.tab--active {
  background: var(--green-soft);
  color: var(--green);
}

.source-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.source-item .result-image {
  height: 360rpx;
  margin-top: 12rpx;
}

.gallery-card {
  margin-bottom: 22rpx;
}

.gallery-image {
  width: 100%;
  border-radius: 16rpx;
}

.gallery-meta {
  margin-top: 12rpx;
}

.json-box {
  max-height: 720rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #10231f;
}

.json-text {
  color: #edf6ff;
  font-family: Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.action-row .button {
  flex: 1;
}
