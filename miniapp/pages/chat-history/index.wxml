<view class="page page--sub">
  <view class="top-title">
    <view>
      <view class="h1">问询记录</view>
      <view class="caption">恢复历史会话，继续围绕原报告上下文追问</view>
    </view>
    <button class="button button--soft history-new" bindtap="startNewSession">新对话</button>
  </view>

  <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  <view class="notice" wx:if="{{loading}}">正在加载问询记录...</view>

  <view wx:if="{{!loading && !sessions.length}}" class="card empty-history">
    <view class="h2">暂无问询记录</view>
    <view class="caption">开始一次 AI 问诊后，会话会保存到这里。</view>
    <button class="button button--primary history-action" bindtap="startNewSession">开始问询</button>
  </view>

  <block wx:if="{{pinnedSessions.length}}">
    <view class="section-title">置顶会话</view>
    <view
      wx:for="{{pinnedSessions}}"
      wx:key="sessionId"
      class="card session-card"
    >
      <view class="row session-head">
        <view class="h2 session-title">{{item.title}}</view>
        <view class="pill pill--amber">置顶</view>
      </view>
      <view class="caption session-meta">{{item.time}} · {{item.messageCount}} 条消息</view>
      <view class="pill pill--green session-context" wx:if="{{item.hasContext}}">{{item.contextLabel}}</view>
      <view class="session-preview">{{item.preview}}</view>
      <view class="session-actions">
        <button class="session-action primary" data-session-id="{{item.sessionId}}" bindtap="restoreSession">继续</button>
        <button class="session-action" data-session-id="{{item.sessionId}}" data-pinned="{{item.pinned}}" bindtap="togglePinned">取消</button>
        <button class="session-action danger" data-session-id="{{item.sessionId}}" bindtap="deleteSession">删除</button>
      </view>
    </view>
  </block>

  <block wx:if="{{recentSessions.length}}">
    <view class="section-title">最近会话</view>
    <view
      wx:for="{{recentSessions}}"
      wx:key="sessionId"
      class="card session-card"
    >
      <view class="row session-head">
        <view class="h2 session-title">{{item.title}}</view>
        <view class="caption">{{item.time}}</view>
      </view>
      <view class="caption session-meta">{{item.messageCount}} 条消息</view>
      <view class="pill pill--green session-context" wx:if="{{item.hasContext}}">{{item.contextLabel}}</view>
      <view class="session-preview">{{item.preview}}</view>
      <view class="session-actions">
        <button class="session-action primary" data-session-id="{{item.sessionId}}" bindtap="restoreSession">继续</button>
        <button class="session-action" data-session-id="{{item.sessionId}}" data-pinned="{{item.pinned}}" bindtap="togglePinned">置顶</button>
        <button class="session-action danger" data-session-id="{{item.sessionId}}" bindtap="deleteSession">删除</button>
      </view>
    </view>
  </block>
</view>
