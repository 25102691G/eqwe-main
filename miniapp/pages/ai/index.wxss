.ai-page {
  padding: 0 24rpx 294rpx;
}

.ai-header {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 22rpx 0 18rpx;
  background: var(--bg-page);
}

.ai-title-block {
  min-width: 0;
}

.header-subtitle {
  margin-top: 4rpx;
}

.ai-header-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.new-chat-button {
  width: 100%;
  min-width: 0;
  height: 56rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.new-chat-button.muted {
  color: var(--muted);
}

.context-strip {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.context-copy {
  flex: 1;
  min-width: 360rpx;
}

.context-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
}

.context-labels {
  margin-top: 8rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 800;
}

.context-summary {
  margin-top: 8rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.context-buttons {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 100%;
}

.text-button {
  min-width: 116rpx;
  height: 50rpx;
  border-radius: 12rpx;
  background: var(--green-soft);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.text-button--muted {
  background: var(--surface-soft);
  color: var(--muted);
}

.chat-scroll {
  height: calc(100vh - 620rpx);
  min-height: 320rpx;
  padding: 8rpx 0 24rpx;
}

.empty-chat {
  padding: 64rpx 24rpx;
  text-align: center;
}

.message-row {
  display: flex;
  margin-bottom: 20rpx;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 84%;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
}

.bubble--user {
  background: var(--green);
  color: #ffffff;
  border-color: var(--green);
}

.bubble-role {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  opacity: 0.75;
}

.bubble-content {
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.input-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 118rpx;
  z-index: 24;
  background: var(--bg-page);
  padding-top: 8rpx;
}

.quick-panel {
  padding: 0 0 6rpx;
}

.quick-panel-title {
  margin-bottom: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 800;
}

.quick-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--green);
  font-size: 24rpx;
  font-weight: 800;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 14rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.98);
}

.composer-input {
  flex: 1;
  min-height: 62rpx;
  max-height: 168rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--bg-page);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.45;
}

.dock-error {
  margin: 0 0 8rpx;
}

.send-button {
  width: 92rpx;
  height: 62rpx;
  border-radius: 14rpx;
  background: var(--green);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 62rpx;
}
